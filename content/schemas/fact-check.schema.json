{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FactChecks",
  "type": "object",
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slug", "claim", "verdict", "short_explanation", "detailed_explanation", "sources", "date_checked", "category"],
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "claim": { "type": "string", "minLength": 10 },
          "verdict": {
            "type": "string",
            "enum": ["verified", "partially_true", "disputed", "unclear"]
          },
          "verdict_label": { "type": "string" },
          "short_explanation": { "type": "string" },
          "detailed_explanation": { "type": "string" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "url", "type"],
              "properties": {
                "name": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "type": { "type": "string", "enum": ["official", "news", "analysis"] }
              }
            }
          },
          "date_checked": { "type": "string" },
          "category": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
